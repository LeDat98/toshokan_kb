# --- Required ---
# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here

# --- Models (defaults shown; override only if needed) ---
# Router/navigator + answerer model
LIBKB_MODEL=gemini-3.5-flash
# Cheap model for classification / question generation (can be same as LIBKB_MODEL)
LIBKB_MODEL_LITE=gemini-3.5-flash
# Embedding model for the card catalog
LIBKB_EMBED_MODEL=gemini-embedding-001

# --- Paths ---
LIBKB_LIBRARY_DIR=./library
LIBKB_DB_PATH=./library/_catalog/catalog.db

# --- Budgets / thresholds ---
LIBKB_MAX_HOPS=12
LIBKB_MAX_PAGES_PER_NAV=6
LIBKB_INGEST_CONFIDENCE_GATE=0.7
